# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, coverage, type-checker, and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.hypothesis/
.test_tmp/
pytest-cache-files-*/
/tests/_pytest_*/
.package_tmp/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/
*.egg
*.pyd
*.so

# Local virtual environments
.venv/
venv/
env/
ENV/

# Local configuration and credentials
.env
.env.*
!.env.example
key.txt

# Notebook and editor state
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
*.swo

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Output created by the MILP tutorial when no path is supplied
/production_milp.lp
